# Secrets: never commit real env files
.env
*.secret.env
*.local.env

# Build, test, coverage
coverage.out
coverage/
dist/
node_modules/
playwright-report/
test-results/

# Runtime secrets: only the dev-only local secret file is committed (dev-only exception)
infra/env/*/secrets/
!infra/env/local/secrets/
!infra/env/local/secrets/postgres_password

# Build output
bin/
