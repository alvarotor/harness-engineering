# DEV-ONLY values for `make up` on a developer machine. Never used by deploy (infra/deploy/deploy.sh does not read
# this folder). Not secrets: the dev password lives in infra/env/local/secrets/. Dev-only exception: see
# docs/standards/security.md accepted risks.
ENV=local
DOMAIN=localhost
ACME_EMAIL=dev@localhost.invalid
HARNESS_ENGINEERING_SECRETS_DIR=./infra/env/local/secrets
